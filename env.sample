NEXT_PUBLIC_ENV_TYPE=<TEST | DEV | ALPHA | PRODUCTION>

NEXT_PUBLIC_SUPABASE_URL=<NEXT_PUBLIC_SUPABASE_URL>

NEXT_PUBLIC_SUPABASE_KEY=<NEXT_PUBLIC_SUPABASE_KEY>

NEXT_PUBLIC_SERVER_BASE_URL=<NEXT_PUBLIC_SERVER_BASE_URL>


# Enable only after configuring and verifying the corresponding Supabase provider.
NEXT_PUBLIC_ENABLE_FACEBOOK_LOGIN=false
NEXT_PUBLIC_ENABLE_APPLE_LOGIN=false
